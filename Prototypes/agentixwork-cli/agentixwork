#!/usr/bin/env zsh
set -euo pipefail

usage() {
  cat <<'EOF'
agentixwork - workflow CLI prototype for AgentixWork Terminal

Usage:
  agentixwork new <name|path> [--nvim] [--no-open] [--git|--no-git]
                          Create a project folder and start working
  agentixwork nvim [path]    Open nvim in a resolved project directory
  agentixwork files [path]   Open/focus file list for a directory
  agentixwork open [path]    Open a directory in cmux/AgentixWork
  agentixwork doctor         Check local tools

New project defaults:
  - Simple names are created under AGENTIXWORK_PROJECTS_DIR or ~/dev
  - Existing directories are reused
  - git init runs when git is available
  - cmux opens the project unless --no-open or --nvim is used

Target path resolution:
  1. explicit path
  2. AGENTIXWORK_TARGET_DIR
  3. CMUX_WORKSPACE_CWD
  4. PWD
  5. HOME
EOF
}

die() {
  print -u2 "agentixwork: $*"
  exit 1
}

expand_path() {
  local raw="${1:-}"
  [[ -n "$raw" ]] || return 1
  raw="${raw/#\~/$HOME}"
  if [[ -d "$raw" ]]; then
    (cd "$raw" && pwd -P)
  elif [[ -e "$raw" ]]; then
    (cd "$(dirname "$raw")" && pwd -P)
  else
    return 1
  fi
}

resolve_target_dir() {
  local explicit="${1:-}"
  local candidate

  for candidate in "$explicit" "${AGENTIXWORK_TARGET_DIR:-}" "${CMUX_WORKSPACE_CWD:-}" "${PWD:-}" "${HOME:-}"; do
    if resolved="$(expand_path "$candidate" 2>/dev/null)"; then
      print -- "$resolved"
      return 0
    fi
  done

  return 1
}

project_target_path() {
  local raw="${1:-}"
  [[ -n "$raw" ]] || die "project name or path is required"
  raw="${raw/#\~/$HOME}"

  if [[ "$raw" == /* || "$raw" == */* ]]; then
    print -- "$raw"
    return 0
  fi

  local base="${AGENTIXWORK_PROJECTS_DIR:-$HOME/dev}"
  print -- "$base/$raw"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  -h|--help|help)
    usage
    ;;

  new)
    project_arg="${1:-}"
    [[ -n "$project_arg" ]] || die "project name or path is required"
    shift || true

    open_after=1
    nvim_after=0
    git_init=1

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --nvim)
          nvim_after=1
          open_after=0
          ;;
        --open)
          open_after=1
          ;;
        --no-open)
          open_after=0
          ;;
        --git)
          git_init=1
          ;;
        --no-git)
          git_init=0
          ;;
        *)
          die "unknown option for new: $1"
          ;;
      esac
      shift
    done

    target="$(project_target_path "$project_arg")"
    mkdir -p "$target"
    target="$(expand_path "$target")" || die "could not resolve created project directory"

    if [[ "$git_init" -eq 1 && ! -d "$target/.git" ]] && command -v git >/dev/null 2>&1; then
      git -C "$target" init >/dev/null
    fi

    print "created - $target"

    if [[ "$nvim_after" -eq 1 ]]; then
      command -v nvim >/dev/null 2>&1 || die "nvim is not installed or not on PATH"
      cd "$target"
      exec nvim
    fi

    if [[ "$open_after" -eq 1 ]]; then
      if command -v cmux >/dev/null 2>&1; then
        exec cmux "$target"
      fi
      print "warn - cmux not found on PATH; open this folder manually"
    fi
    ;;

  nvim)
    target="$(resolve_target_dir "${1:-}")" || die "could not resolve target directory"
    command -v nvim >/dev/null 2>&1 || die "nvim is not installed or not on PATH"
    cd "$target"
    exec nvim
    ;;

  files)
    target="$(resolve_target_dir "${1:-}")" || die "could not resolve target directory"
    if command -v cmux >/dev/null 2>&1; then
      exec cmux open "$target"
    fi
    print -- "$target"
    ;;

  open)
    target="$(resolve_target_dir "${1:-}")" || die "could not resolve target directory"
    if command -v cmux >/dev/null 2>&1; then
      exec cmux "$target"
    fi
    die "cmux is not installed or not on PATH"
    ;;

  doctor)
    print "AgentixWork CLI prototype"
    print "info - default project folder: ${AGENTIXWORK_PROJECTS_DIR:-$HOME/dev}"
    if command -v cmux >/dev/null 2>&1; then
      print "ok - cmux: $(command -v cmux)"
    else
      print "warn - cmux not found on PATH"
    fi
    if command -v nvim >/dev/null 2>&1; then
      print "ok - nvim: $(command -v nvim)"
    else
      print "warn - nvim not found on PATH"
    fi
    if command -v hunk >/dev/null 2>&1; then
      print "ok - hunk: $(command -v hunk)"
    else
      print "warn - hunk not found on PATH; install with: npm i -g hunkdiff"
    fi
    print "info - recommended Neovim setup: https://github.com/baryonlabs/cmux_setting_vscode_style_nvim"
    print "info - recommended diff review tool: https://github.com/modem-dev/hunk"
    ;;

  *)
    usage
    die "unknown command: $cmd"
    ;;
esac
